COMPOSE_PROJECT_NAME=under-review
POSTGRES_USER=under_review
POSTGRES_DB=under_review
POSTGRES_PASSWORD=replace-with-random-secret
DATABASE_URL=postgresql://under_review:replace-with-random-secret@127.0.0.1:5439/under_review
SITE_URL=http://localhost:4380
PRIVATE_STAGING=true
TARGET_SEASON=2026
LIVE_POSTING_ALLOWED=false
SESSION_SECRET=generate-with-npm-run-local-init
TOKEN_ENCRYPTION_KEY=generate-with-npm-run-local-init
BRAND_NAME=Under Review
BRAND_TAGLINE=What actually swung the game?
CLOSE_CALL_TOLERANCE=0.01
ANALYTICS_TIMEOUT_MS=900000
# Optional server-side X application credentials. Never required for local use.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=
