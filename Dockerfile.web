FROM node:24.15.0-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/core/package.json packages/core/package.json
RUN npm ci
COPY tsconfig.json ./
COPY packages packages
COPY apps/web apps/web
RUN npm run build

FROM node:24.15.0-bookworm-slim AS runtime
WORKDIR /app
LABEL org.opencontainers.image.source=https://github.com/yaboijbigs/under-review
COPY LICENSE THIRD_PARTY_NOTICES.md DATA_SOURCES.md ./
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 PROJECT_ROOT=/app KEEP_ALIVE_TIMEOUT=120000
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
